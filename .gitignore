# Keep game data and generated patches out of the repository.
*.3[dD][sS]
*.[cC][cC][iI]
*.3[dD][zZ]
*.[cC][iI][aA]
*.[cC][xX][iI]
*.[cC][sS][uU]
patches/
*_patches/
romfs/
exefs/
exheader.bin
logo.bin
plain.bin
*.bps
*.garcpatch
*.7z
*.zip
*.bin
*.garc
*.romfs
*.exefs
*.ncch
*.rsf
*.repaired*
*.text_repair_state*

# Build tools, reports, and temporary game copies contain generated data.
/build/
/dist/
/reports/
/tools/
GamePatcher_*/
GameBase_*/
GameBuild_*/
.GameOutput_*/

# Python environments and caches can be recreated from source.
.venv/
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Native binaries and compiler output belong in build or dist.
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.a
*.lib
*.exp
*.pdb
*.ilk
*.spec
!scripts/programs.spec
*.app/
*.log

# Ignore operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini
